  "definitions": {
    "ambulance_hours": "Sum over incidents of hours from scene-ready until the ambulance is back at its base (nearest GoldenHour standby site to the scene).",
    "critical": "Care categories with lambda 0 in the base config, excluding arrest_airway: obstetric, paediatric, severe_trauma, stemi, stroke.",
    "critical_capable_first_attempt_share": "Share of critical patients treated at the first hospital the ambulance reached (it had the capability and took them).",
    "delta_mean_ttt_critical": "advisor minus nearest mean time to treatment for critical patients; negative = advisor better.",
    "fallbacks": "Times the pre-alert moved to the next hospital after a reject or timeout (advisor only).",
    "nearest_prealert": "Reference policy, not a proposal: pre-alert 24x7 EDs nearest-first with the same simulated answers but no advisor triage or ranking. Separates the gain from pre-alerting itself.",
    "prealert_rejects": "Pre-alerts the simulated hospital explicitly rejected (advisor only).",
    "secondary_transfers": "Patients moved on at least once after arriving at a hospital (refused, or it lacked the capability for the true category).",
    "time_to_treatment": "Minutes from the crew being ready to leave the scene (before any pre-alert wait) until the patient gets an ED bay at a hospital that can treat their TRUE (sampled) care category. Patients who never reach such a hospital are excluded from the statistic and counted in no_definitive_care.",
    "true_category": "Sampled from the call's complaint and config sim.* shares, never from the advisor's triage. Over-triaged patients (e.g. no-ECG chest pain that is not STEMI) count as low_acuity."
  },
